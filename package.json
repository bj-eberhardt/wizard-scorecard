{
  "name": "wizard-scoreboard",
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e playwright.config.ts vite.config.ts vitest.config.ts",
    "prettier": "prettier --write src/**/*.{ts,tsx,js,jsx} e2e/**/*.ts playwright.config.ts vite.config.ts vitest.config.ts",
    "prettier:check": "prettier --check src/**/*.{ts,tsx,js,jsx} e2e/**/*.ts playwright.config.ts vite.config.ts vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "format": "npm run prettier && npm run lint",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "docs:screenshots": "npm run build && node scripts/capture-readme.mjs"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "i18next": "^26.5.12",
    "i18next-browser-languagedetector": "^8.2.4",
    "lucide-react": "^1.66.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
